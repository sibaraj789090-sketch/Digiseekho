# DigiSeekho Production Environment Configuration

# Supabase PostgreSQL & Auth Credentials
# Get these from your Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Server-Side / Supabase Service Role Key (for administrative scripts/migrations - never expose to browser)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Domain & Site URL (used for canonical URLs, sitemaps, RSS feeds, and OpenGraph cards)
VITE_SITE_URL="https://digiseekho.com"

# Next.js / Vercel equivalents (if deploying to Next.js on Vercel)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
NEXT_PUBLIC_SITE_URL="https://digiseekho.com"

